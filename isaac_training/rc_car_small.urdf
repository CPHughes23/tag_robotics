<?xml version="1.0"?>
<!-- RC car scaled to 1/3 of the original in all linear dimensions.
     Mass scales as (1/3)^3 = 1/27, inertia as (1/3)^5 = 1/243. -->
<robot name="rc_car_small">

  <!-- Chassis -->
  <link name="chassis">
    <inertial>
      <mass value="0.037"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.0000412" iyy="0.0000823" izz="0.0000823" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size="0.1 0.05 0.023"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size="0.1 0.05 0.023"/>
      </geometry>
    </collision>
  </link>

  <!-- Rear Left Wheel -->
  <link name="rear_left_wheel">
    <inertial>
      <mass value="0.0037"/>
      <inertia ixx="0.00000033" iyy="0.00000033" izz="0.00000033" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <geometry>
        <cylinder radius="0.0133" length="0.01"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.0133" length="0.01"/>
      </geometry>
    </collision>
  </link>

  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="chassis"/>
    <child link="rear_left_wheel"/>
    <origin xyz="-0.04 0.03 -0.01" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.01" friction="0.0"/>
  </joint>

  <!-- Rear Right Wheel -->
  <link name="rear_right_wheel">
    <inertial>
      <mass value="0.0037"/>
      <inertia ixx="0.00000033" iyy="0.00000033" izz="0.00000033" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <geometry>
        <cylinder radius="0.0133" length="0.01"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.0133" length="0.01"/>
      </geometry>
    </collision>
  </link>

  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="chassis"/>
    <child link="rear_right_wheel"/>
    <origin xyz="-0.04 -0.03 -0.01" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.01" friction="0.0"/>
  </joint>

  <!-- Front Left Steer Link -->
  <link name="front_left_steer_link">
    <inertial>
      <mass value="0.00037"/>
      <inertia ixx="0.0000000041" iyy="0.0000000041" izz="0.0000000041" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="front_left_steer_joint" type="revolute">
    <parent link="chassis"/>
    <child link="front_left_steer_link"/>
    <origin xyz="0.04 0.03 -0.01" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.5" upper="0.5" effort="10.0" velocity="1.0"/>
    <dynamics damping="1.0" friction="0.0"/>
  </joint>

  <!-- Front Left Wheel -->
  <link name="front_left_wheel">
    <inertial>
      <mass value="0.0037"/>
      <inertia ixx="0.00000033" iyy="0.00000033" izz="0.00000033" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <geometry>
        <cylinder radius="0.0133" length="0.01"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.0133" length="0.01"/>
      </geometry>
    </collision>
  </link>

  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="front_left_steer_link"/>
    <child link="front_left_wheel"/>
    <origin xyz="0 0 0" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.01" friction="0.0"/>
  </joint>

  <!-- Front Right Steer Link -->
  <link name="front_right_steer_link">
    <inertial>
      <mass value="0.00037"/>
      <inertia ixx="0.0000000041" iyy="0.0000000041" izz="0.0000000041" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="front_right_steer_joint" type="revolute">
    <parent link="chassis"/>
    <child link="front_right_steer_link"/>
    <origin xyz="0.04 -0.03 -0.01" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.5" upper="0.5" effort="10.0" velocity="1.0"/>
    <dynamics damping="1.0" friction="0.0"/>
  </joint>

  <!-- Front Right Wheel -->
  <link name="front_right_wheel">
    <inertial>
      <mass value="0.0037"/>
      <inertia ixx="0.00000033" iyy="0.00000033" izz="0.00000033" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <geometry>
        <cylinder radius="0.0133" length="0.01"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.0133" length="0.01"/>
      </geometry>
    </collision>
  </link>

  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="front_right_steer_link"/>
    <child link="front_right_wheel"/>
    <origin xyz="0 0 0" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.01" friction="0.0"/>
  </joint>

</robot>
